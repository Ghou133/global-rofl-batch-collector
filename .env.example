# Obtain a key at https://developer.riotgames.com/
RIOT_API_KEY=

# Riot international platform; default KR. See `collector --help` for all choices.
# COLLECTOR_PLATFORM=KR

# Optional overrides. The defaults work for a standard Windows installation.
# LEAGUE_INSTALL_DIR=C:\Riot Games\League of Legends
# COLLECTOR_DATA_DIR=data
# COLLECTOR_DB_PATH=data/collector.sqlite3
# REPLAY_EDGE_BASE_URL=https://example-red.pp.example.pvp.net
